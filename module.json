{
  "id": "npc-token-replacer",
  "title": "NPC Token Replacer",
  "description": "Replaces NPC tokens in the current scene with official D&D compendium versions. Every installed official source is detected automatically - no module list to maintain - and position, elevation, dimensions and visibility are preserved.",
  "version": "1.5.0",
  "compatibility": {
    "minimum": "12",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Aiacos"
    }
  ],
  "url": "https://github.com/Aiacos/npc-token-replacer",
  "manifest": "https://github.com/Aiacos/npc-token-replacer/releases/latest/download/module.json",
  "download": "https://github.com/Aiacos/npc-token-replacer/releases/download/v1.5.0/npc-token-replacer-v1.5.0.zip",
  "styles": [
    "styles/npc-token-replacer.css"
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system"
      }
    ]
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "html",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  }
}
